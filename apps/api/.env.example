NODE_ENV=development
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Local (Docker):  postgresql://postgres:postgres@localhost:5432/document_intel
# Railway:         copy DATABASE_URL from Railway project dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/document_intel

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Free tier at https://resend.com — 3 000 emails/month
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@example.com

# ── URLs ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# ── OCR Module ────────────────────────────────────────────────────────────────
OCR_UPLOAD_DIR=uploads/ocr
OCR_MAX_FILE_MB=50

# ── File Storage ──────────────────────────────────────────────────────────────
# 'local' stores files on disk (OCR_UPLOAD_DIR above)
# 's3'    stores files in S3-compatible storage (fill in S3_* below)
STORAGE_PROVIDER=local

# S3_BUCKET=my-bucket
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # R2/MinIO only — omit for AWS
# S3_PUBLIC_URL=https://pub.example.com                    # optional CDN base URL
