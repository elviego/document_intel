NODE_ENV=development
PORT=4000

# Railway PostgreSQL — copy from Railway project dashboard
DATABASE_URL=postgresql://postgres:[password]@[host].railway.app:5432/railway

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=

# Resend — https://resend.com
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@triboverde.pt

# URLs
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# OCR Module
OCR_UPLOAD_DIR=uploads/ocr
OCR_MAX_FILE_MB=50

# File Storage: 'local' (default) or 's3' (Cloudflare R2, AWS S3, MinIO)
STORAGE_PROVIDER=local
# S3_BUCKET=my-bucket
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS
# S3_PUBLIC_URL=https://pub.example.com                    # optional CDN base URL
