{
  "name": "@fin-tribe/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fin-tribe/shared-types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "resend": "^4.0.1",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.1.0",
    "@fastify/swagger-ui": "^5.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.23.8",
    "date-fns": "^4.1.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1"
  },
  "devDependencies": {
    "@fin-tribe/eslint-config": "workspace:*",
    "@fin-tribe/tsconfig": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.6"
  }
}
